# Copy to .env (or export) and adjust.
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartqueue?sslmode=disable

# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_TTL_HOURS=12

# Business day boundaries (token numbering resets daily, dashboard = "today").
APP_TIMEZONE=Asia/Kolkata

# Comma separated browser origins allowed to call the API, or * for any.
CORS_ORIGINS=*
# Set true behind a reverse proxy so rate limiting uses X-Forwarded-For.
TRUST_PROXY=false

# First-start seeding (only when no users exist yet).
ADMIN_EMAIL=admin@office.local
ADMIN_PASSWORD=Admin@123
SEED_DEMO_STAFF=true
STAFF_PASSWORD=Staff@123

# Abuse protection on public endpoints (requests per IP per minute; 0 = off).
TOKEN_RATE_PER_MIN=20
LOGIN_RATE_PER_MIN=10

# Optional: serve a built Flutter web app (app/build/web) from the same server.
WEB_DIR=
